{% if renovate_preset -%}
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>{{ renovate_preset }}"]
}
{%- else -%}
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Etc/UTC",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Batch runtime, test and docs dependencies into one low-noise PR.",
      "matchManagers": ["pep621"],
      "groupName": "python-dependencies",
      "addLabels": ["python"]
    },
    {
      "description": "Lockstep the version-sensitive lint tools so local == CI stays true after an upgrade. prek pins the builtin hooks' implementations, so it moves with the linters.",
      "matchPackageNames": ["ruff", "rumdl", "ty", "interrogate", "prek"],
      "groupName": "lint-tools",
      "addLabels": ["python"]
    },
    {
      "description": "Label GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "addLabels": ["ci"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump versions annotated with a `# renovate:` comment in workflow files (the pinned uv, nox and git-cliff versions that no built-in manager reads).",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[^\\n]*?(?<currentValue>\\d[^\"\\s]*)"
      ]
    }
  ]
}
{%- endif %}
